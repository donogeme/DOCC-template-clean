# Sensitive / personal data that should NOT be committed
# when you fork this template for personal use

# Local credentials & machine-local config (created from the *.example files
# by setup.sh — these hold API tokens, paths, and permission allowlists).
# The committed *.example templates stay tracked; the live files never are.
.mcp.json
.claude/settings.local.json
.env
.env.*
!.env.example

# Generated session log (machine-local)
ops/_session-log.md

# Add your own sensitive files below:
# ops/_contacts.md       # if you want to keep contacts private
# ops/*/                 # if you want to keep all project data private

# OS
.DS_Store
Thumbs.db

# Claude
.claude/scheduled_tasks.lock
debug.log

# Extractors — redacted fixtures and the residue tally never leave disk
ops/_extractors/**/fixtures/*
!ops/_extractors/**/fixtures/.gitkeep
ops/_extractors/_residue-tally.jsonl

# Traces — local-only session/debug artifacts (keep README + .gitkeep only)
ops/_traces/*
!ops/_traces/README.md
!ops/_traces/.gitkeep
